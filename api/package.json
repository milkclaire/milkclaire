{
	"name": "@milkclaire/api",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/app.ts"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"db:generate": "drizzle-kit generate",
