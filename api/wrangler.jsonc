{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/app.ts",
	"compatibility_date": "2026-10-28",
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60,
			},
		},
	],
	"d1_databases": [
		{
			"binding": "milkclaire",
			"database_name": "milkclaire",
			"migrations_dir": "drizzle/migrations",
		},
	],
}
